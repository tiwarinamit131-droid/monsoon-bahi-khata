{
  "name": "monsoon-bahi-khata",
  "version": "1.0.0",
  "private": true,
  "description": "A cinematic, fully client-side analytics engine for the Indian monsoon: descriptive, diagnostic, predictive and prescriptive, in one page.",
  "author": "Namit Tiwari",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/engine/**\" --test-reporter=spec \"tests/**/*.test.ts\"",
    "bench": "node bench/run.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "set-repo": "node scripts/set-repo.mjs"
  },
  "dependencies": {
    "@fontsource/baloo-2": "5.3.0",
    "@fontsource/mukta": "5.3.0",
    "@fontsource/rozha-one": "5.3.0",
    "@fontsource/spline-sans-mono": "5.3.0",
    "chart.js": "4.6.1",
    "d3": "7.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/d3": "7.4.3",
    "@types/node": "22.20.5",
    "eslint": "10.9.1",
    "globals": "16.4.0",
    "prettier": "3.9.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6"
  }
}
